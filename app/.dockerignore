# イメージ内で composer install / npm ci を実行するため、
# ホスト側の成果物は一切コンテキストに含めない
src/vendor
src/node_modules
src/public/build
src/public/hot
src/public/storage

# 環境依存の設定・機密情報
src/.env
src/.env.*
!src/.env.example

# 実行時に生成されるもの
src/storage/framework/cache/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/storage/logs/*
src/bootstrap/cache/*
src/.phpunit.result.cache

# 開発用コンテナ定義（本番イメージには不要）
docker-compose.yml

.git
.gitignore
README.md
