# syntax=docker/dockerfile:1
#
# 本番用イメージ（ECRへプッシュしてECSで実行する）
#
# 開発用のDockerfileはソースを./srcからボリュームマウントする前提だが、
# こちらはアプリケーションコード・vendor・ビルド済みフロント資産を
# すべてイメージ内に焼き込む。
#
# ビルドコンテキストは app/ ディレクトリ:
#   docker build -f docker/php/Dockerfile.prod .

###############################################################################
# ステージ1: PHP依存関係のインストール
###############################################################################
FROM composer:2 AS vendor

WORKDIR /app

# 依存定義だけを先にコピーしてレイヤキャッシュを効かせる。
# この時点ではartisanが無いためスクリプトとオートローダ生成は行わない
COPY src/composer.json src/composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction

# アプリ本体をコピーしてから最適化オートローダを生成する
# （post-autoload-dumpでpackage:discoverが実行される）
COPY src/ ./
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

###############################################################################
# ステージ2: フロントエンド資産のビルド（Vite / Tailwind）
###############################################################################
FROM node:22-slim AS assets

WORKDIR /app

COPY src/package.json src/package-lock.json ./
RUN npm ci

COPY src/ ./
RUN npm run build

###############################################################################
# ステージ3: 実行イメージ
###############################################################################
FROM php:8.4-fpm

# 開発用Dockerfileと同じ拡張機能を導入し、ローカルとの差異をなくす
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    && docker-php-ext-install \
    pdo_mysql \
    zip \
    bcmath \
    mbstring \
    exif \
    pcntl \
    gd \
    opcache \
    && rm -rf /var/lib/apt/lists/*

# 本番向けのopcache設定（ソースは不変なのでタイムスタンプ検証を切る）
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.memory_consumption=192'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# php.iniは公式が同梱する本番向け推奨設定を使う
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

WORKDIR /var/www/html

COPY --from=vendor --chown=www-data:www-data /app /var/www/html
COPY --from=assets --chown=www-data:www-data /app/public/build /var/www/html/public/build

# Laravelが書き込むディレクトリを用意する
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data

CMD ["php-fpm"]
